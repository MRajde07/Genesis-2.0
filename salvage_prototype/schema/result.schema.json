{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SALVAGE per-file result",
  "type": "object",
  "required": ["file_name", "format", "status", "data", "errors"],
  "properties": {
    "file_name": {"type": "string"},
    "format": {"type": "string"},
    "status": {"enum": ["success", "partially_recovered", "damaged", "unsupported", "error"]},
    "data": {},
    "errors": {"type": "array", "items": {"type": "string"}},
    "damage": {"type": "array", "items": {"type": "object", "required": ["message"], "properties": {"message": {"type": "string"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}}}}
  },
  "additionalProperties": true
}
