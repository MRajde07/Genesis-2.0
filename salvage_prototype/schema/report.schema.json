{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SALVAGE batch report",
  "description": "SALVAGE report.json output contract. Totals count files by status, not records. Compatible with SALVAGE's built-in subset validator.",
  "type": "object",
  "required": [
    "tool_version",
    "files",
    "totals"
  ],
  "properties": {
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "LIBRA-98",
              "LABLOG",
              "VAULT",
              "WKS",
              "WPD",
              "BRAVO",
              "CVT",
              "EBCDIC-DUMP",
              "WAD",
              "PAK",
              "UNKNOWN"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "partial",
              "unsupported",
              "unrecognized",
              "failed"
            ]
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "damage": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "file",
          "format",
          "status",
          "records",
          "damage"
        ],
        "additionalProperties": true
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "unrecognized": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ok",
        "partial",
        "unsupported",
        "unrecognized",
        "failed"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
